# ====================================================================
# MartFlow AI — Production SaaS Environment Configuration Template
# Copy to .env and fill in your authorized provider credentials.
# NEVER commit .env or secrets to version control.
# ====================================================================

# 1. Server Configuration
PORT=3000
NODE_ENV=production
SESSION_SECRET=your_cryptographically_secure_random_session_secret_here

# 2. Database & Storage (Supabase / Managed PostgreSQL)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/martflow_ai
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Google Gemini AI Engine
# Get free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Official Meta WhatsApp Business Cloud API
# Required for Official Cloud Platform integration: https://developers.facebook.com/
WHATSAPP_CLOUD_TOKEN=your_permanent_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_WABA_ID=your_whatsapp_business_account_id_here
WHATSAPP_VERIFY_TOKEN=martflow_verify_secret

# 5. IndiaMART Push API Webhook
INDIAMART_GLID=your_indiamart_glid_here
INDIAMART_CRM_KEY=your_indiamart_crm_key_here

# 6. Two-Way Factory Call Booking
# Default fallback mobile number for factory owner call confirmations (e.g., 919876543210)
OWNER_ALERT_PHONE=919876543210

# 7. Razorpay Subscriptions & Billing (Optional)
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# 8. Merchant Direct UPI (0% Fee Bank Settlement)
MERCHANT_UPI_ID=payments@martflow.ai
MERCHANT_NAME=MartFlow AI
